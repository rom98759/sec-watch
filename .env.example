# Copy to .env and `chmod 600 .env`. Never commit .env.

# Discord channel webhook (Channel settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=

# Fine-grained GitHub token, read-only, "All repositories":
#   Repository permissions: Dependabot alerts = Read, Pull requests = Read (Metadata = Read is implied)
# Leave empty to disable the GitHub watch.
GITHUB_TOKEN=

TZ=Europe/Paris

# Optional tuning (defaults shown)
# TRIVY_SEVERITY=CRITICAL,HIGH
# SCAN_HOUR=4               # daily Trivy scan, local hour
# WEEKLY_DAY=0              # weekly summary day, 0 = Monday
# GITHUB_INTERVAL_MIN=60
# DRY_RUN=1                 # print messages to logs instead of Discord
