# Project EditorConfig (kept in sync with ~/.editorconfig)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_size = 4

[*.{c,h,cpp,hpp}]
indent_style = tab
indent_size = 4

[{Makefile,*.mk,go.mod,*.go}]
indent_style = tab

[*.sh]
indent_style = tab

[*.md]
# two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false
